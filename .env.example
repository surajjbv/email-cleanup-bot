# Copy to .env and fill in. .env is gitignored; never commit it.

# Google: a Desktop OAuth client with the Gmail API enabled. You can reuse the client ID and secret
# from school-reminder-bot. Then run `npm run login` and sign in with the mailbox to clean.
# Scope: gmail.modify (read + move to Trash). The bot can't send mail or delete permanently.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# LM Studio model (reused if already loaded; otherwise loaded for the run, then unloaded).
# Qwen3.8 27B needs about 21 GB free. If LM Studio's guardrails would refuse it, MODEL_FALLBACK is used.
MODEL=qwen3.8-27b-mlx
MODEL_FALLBACK=gemma-4-26b-a4b-it-qat-mlx

# Daily run time lives in config.json (used by schedule.sh when a schedule is installed).

# true = only report what would be unsubscribed/trashed. Set to false after checking a dashboard or two.
DRY_RUN=true

# The first run summarises this many hours of inbox mail; later runs read everything since the last run.
FIRST_RUN_HOURS=48
# Caps per run (keeps a run to a few minutes)
MAX_INBOX=60
MAX_SPAM=300
