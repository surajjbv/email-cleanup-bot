# Copy to .env and fill in. .env is gitignored; never commit it. Everything else is in config.json.

# Google: a Desktop OAuth client with the Gmail API enabled. You can reuse the client ID and secret
# from school-reminder-bot. Then run `npm run login` and sign in with the mailbox to clean.
# Scope: gmail.modify (read + move to Trash). The bot can't send mail or delete permanently.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
